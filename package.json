{
  "name": "abele-node",
  "version": "0.3.1",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/dudaanton/abele-node.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/prepare-pi.mjs && tsc -b",
    "acceptance": "npm run build && node scripts/acceptance.mjs",
    "acceptance:stage2": "npm run build && node scripts/acceptance-stage2.mjs",
    "acceptance:stage3": "npm run build && node scripts/acceptance-stage3.mjs",
    "acceptance:stage4b": "npm run build && node scripts/acceptance-stage4b.mjs",
    "acceptance:remote": "npm run build && vitest run tests/pairing.test.ts tests/paired-security.test.ts tests/paired-daemon.test.ts tests/tailscale.test.ts tests/serve-ownership.test.ts tests/paired-timeout.test.ts",
    "acceptance:pi": "npm run build && node scripts/acceptance-pi.mjs",
    "acceptance:delegation": "npm run build && vitest run tests/delegation",
    "types": "tsc -b && tsc -p tsconfig.tests.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "test:installer": "npm run build && node scripts/package-release.mjs && node scripts/test-installer.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  }
}
